{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liandan.local/schemas/config/m2-prototype.schema.json",
  "title": "M2 单材料闭环原型",
  "type": "object",
  "required": [
    "schemaVersion",
    "seed",
    "logicalWidth",
    "logicalHeight",
    "materialPlacement",
    "availableFireSourceIds",
    "initialFireSize",
    "fireSizeWheelStep",
    "initialFireDirection",
    "theme",
    "inventoryBatches"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "logicalWidth": { "type": "integer", "minimum": 320, "maximum": 8192 },
    "logicalHeight": { "type": "integer", "minimum": 240, "maximum": 8192 },
    "materialPlacement": {
      "type": "object",
      "required": [
        "centerX",
        "centerY",
        "size",
        "offsetPerInstance",
        "rotationDegreesPerInstance"
      ],
      "properties": {
        "centerX": { "type": "number", "minimum": 0, "maximum": 8192 },
        "centerY": { "type": "number", "minimum": 0, "maximum": 8192 },
        "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 4096 },
        "offsetPerInstance": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": -8192, "maximum": 8192 },
            "y": { "type": "number", "minimum": -8192, "maximum": 8192 }
          },
          "additionalProperties": false
        },
        "rotationDegreesPerInstance": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "availableFireSourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "initialFireSize": { "type": "number", "minimum": 0, "maximum": 100 },
    "fireSizeWheelStep": { "type": "number", "minimum": 1, "maximum": 20 },
    "initialFireDirection": { "$ref": "#/$defs/direction" },
    "theme": {
      "type": "object",
      "required": ["colors", "radius"],
      "properties": {
        "colors": {
          "type": "object",
          "required": [
            "background",
            "surface",
            "surfaceRaised",
            "border",
            "text",
            "muted",
            "accent",
            "danger",
            "focus"
          ],
          "properties": {
            "background": { "$ref": "#/$defs/color" },
            "surface": { "$ref": "#/$defs/color" },
            "surfaceRaised": { "$ref": "#/$defs/color" },
            "border": { "$ref": "#/$defs/color" },
            "text": { "$ref": "#/$defs/color" },
            "muted": { "$ref": "#/$defs/color" },
            "accent": { "$ref": "#/$defs/color" },
            "danger": { "$ref": "#/$defs/color" },
            "focus": { "$ref": "#/$defs/color" }
          },
          "additionalProperties": false
        },
        "radius": { "type": "number", "minimum": 0, "maximum": 24 }
      },
      "additionalProperties": false
    },
    "inventoryBatches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["batchId", "materialDefinitionId", "servings"],
        "properties": {
          "batchId": { "$ref": "#/$defs/stableId" },
          "materialDefinitionId": { "$ref": "#/$defs/stableId" },
          "servings": { "type": "integer", "minimum": 1, "maximum": 100000 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "direction": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -1, "maximum": 1 },
        "y": { "type": "number", "minimum": -1, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
