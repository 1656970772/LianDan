{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liandan.local/schemas/config/m2-interactions.schema.json",
  "title": "M4 精灵珠邻近互动",
  "type": "object",
  "required": ["schemaVersion", "interactions"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "interactions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "id",
          "behavior",
          "participantA",
          "participantB",
          "distance",
          "durationSeconds",
          "impulse",
          "cooldownSeconds"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "nameZh": { "type": "string", "minLength": 1, "maxLength": 64 },
          "behavior": { "const": "fight" },
          "participantA": { "$ref": "#/$defs/selector" },
          "participantB": { "$ref": "#/$defs/selector" },
          "distance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
          "impulse": { "type": "number", "minimum": 0, "maximum": 10000 },
          "cooldownSeconds": { "type": "number", "minimum": 0, "maximum": 600 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "selector": {
      "type": "object",
      "properties": {
        "materialDefinitionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "requiredTagIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "pearlTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["medicinalLiquid", "slag", "impurity"] }
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
