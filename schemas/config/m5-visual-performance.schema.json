{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liandan.local/schemas/config/m5-visual-performance.schema.json",
  "title": "M5 正式表现性能场景",
  "type": "object",
  "required": ["schemaVersion", "id", "benchmarkKind", "protocol", "scenarios"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "const": "m5-visual-performance" },
    "benchmarkKind": { "type": "string", "const": "presentation-only" },
    "protocol": {
      "type": "object",
      "required": ["warmupSeconds", "sampleSeconds", "viewportWidth", "viewportHeight", "deviceScaleFactor", "maximumRecordedFramesPerSecond"],
      "properties": {
        "warmupSeconds": { "type": "integer", "minimum": 0, "maximum": 60 },
        "sampleSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "viewportWidth": { "type": "integer", "minimum": 320, "maximum": 7680 },
        "viewportHeight": { "type": "integer", "minimum": 240, "maximum": 4320 },
        "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
        "maximumRecordedFramesPerSecond": { "type": "integer", "minimum": 60, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "seed", "activePearlCount", "fireSize", "interactionGroupCount", "pearlTypeWeights", "motion", "effectSchedule", "requiredEffectKinds", "effectPool", "audio", "thresholds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "activePearlCount": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "fireSize": { "type": "integer", "minimum": 0, "maximum": 100 },
        "interactionGroupCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "pearlTypeWeights": {
          "type": "object",
          "required": ["medicinalLiquid", "slag", "impurity"],
          "properties": {
            "medicinalLiquid": { "type": "number", "minimum": 0, "maximum": 1 },
            "slag": { "type": "number", "minimum": 0, "maximum": 1 },
            "impurity": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "required": ["horizontalAmplitudePixels", "verticalAmplitudePixels", "cyclesPerSecond"],
          "properties": {
            "horizontalAmplitudePixels": { "type": "number", "minimum": 0, "maximum": 128 },
            "verticalAmplitudePixels": { "type": "number", "minimum": 0, "maximum": 128 },
            "cyclesPerSecond": { "type": "number", "minimum": 0, "maximum": 30 }
          },
          "additionalProperties": false
        },
        "effectSchedule": {
          "type": "object",
          "required": ["steamPerSecond", "shieldPerSecond", "damagePerSecond", "fightPerSecond"],
          "properties": {
            "steamPerSecond": { "type": "number", "minimum": 0, "maximum": 1000 },
            "shieldPerSecond": { "type": "number", "minimum": 0, "maximum": 1000 },
            "damagePerSecond": { "type": "number", "minimum": 0, "maximum": 1000 },
            "fightPerSecond": { "type": "number", "minimum": 0, "maximum": 1000 }
          },
          "additionalProperties": false
        },
        "requiredEffectKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["steam", "shield", "damage", "fight"] }
        },
        "effectPool": {
          "type": "object",
          "required": ["initialCapacity", "maximumCapacity"],
          "properties": {
            "initialCapacity": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maximumCapacity": { "type": "integer", "minimum": 1, "maximum": 10000 }
          },
          "additionalProperties": false
        },
        "audio": {
          "type": "object",
          "required": ["enabled", "cueIntervalMilliseconds"],
          "properties": {
            "enabled": { "type": "boolean" },
            "cueIntervalMilliseconds": { "type": "integer", "minimum": 16, "maximum": 10000 }
          },
          "additionalProperties": false
        },
        "thresholds": {
          "type": "object",
          "required": ["minimumFramesPerCompleteSecond", "minimumInteractionGroupCount", "maximumDroppedEffectCount", "minimumAudioVoiceHighWaterMark", "maximumTrackedFrameAllocationCount"],
          "properties": {
            "minimumFramesPerCompleteSecond": { "type": "integer", "minimum": 1, "maximum": 240 },
            "minimumInteractionGroupCount": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "maximumDroppedEffectCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "minimumAudioVoiceHighWaterMark": { "type": "integer", "minimum": 0, "maximum": 64 },
            "maximumTrackedFrameAllocationCount": { "type": "integer", "minimum": 0, "maximum": 1000000 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
