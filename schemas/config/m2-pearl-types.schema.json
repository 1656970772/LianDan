{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liandan.local/schemas/config/m2-pearl-types.schema.json",
  "title": "M3 三类精灵珠配置",
  "type": "object",
  "required": ["schemaVersion", "pearlTypes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "pearlTypes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pearlType",
          "standardRadius",
          "color",
          "outlineColor",
          "spawnVelocity",
          "gravity",
          "drift",
          "maxSpeed",
          "materialRestitution",
          "wallRestitution",
          "fireProtectionSeconds",
          "resetProtectionOnExit",
          "burnDurationSeconds",
          "thrustAcceleration"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "pearlType": {
            "type": "string",
            "enum": ["medicinalLiquid", "slag", "impurity"]
          },
          "standardRadius": { "type": "number", "exclusiveMinimum": 0, "maximum": 512 },
          "color": { "$ref": "#/$defs/hexColor" },
          "outlineColor": { "$ref": "#/$defs/hexColor" },
          "spawnVelocity": {
            "type": "object",
            "required": ["minX", "maxX", "minY", "maxY"],
            "properties": {
              "minX": { "type": "number", "minimum": -4096, "maximum": 4096 },
              "maxX": { "type": "number", "minimum": -4096, "maximum": 4096 },
              "minY": { "type": "number", "minimum": -4096, "maximum": 4096 },
              "maxY": { "type": "number", "minimum": -4096, "maximum": 4096 }
            },
            "additionalProperties": false
          },
          "gravity": { "type": "number", "minimum": 0, "maximum": 8192 },
          "drift": { "type": "number", "minimum": 0, "maximum": 4096 },
          "maxSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 },
          "materialRestitution": { "type": "number", "minimum": 0, "maximum": 1 },
          "wallRestitution": { "type": "number", "minimum": 0, "maximum": 1 },
          "fireProtectionSeconds": { "type": "number", "minimum": 0, "maximum": 10 },
          "resetProtectionOnExit": { "type": "boolean" },
          "burnDurationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
          "thrustAcceleration": { "type": "number", "minimum": 0, "maximum": 8192 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  },
  "additionalProperties": false
}
