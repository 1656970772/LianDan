{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liandan.local/schemas/config/m2-collector.schema.json",
  "title": "M2 接液容器配置",
  "type": "object",
  "required": [
    "schemaVersion",
    "initialX",
    "y",
    "width",
    "height",
    "minX",
    "maxX",
    "acceleration",
    "deceleration",
    "maxSpeed"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "initialX": { "type": "number", "minimum": 0, "maximum": 8192 },
    "y": { "type": "number", "minimum": 0, "maximum": 8192 },
    "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 2048 },
    "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 2048 },
    "minX": { "type": "number", "minimum": 0, "maximum": 8192 },
    "maxX": { "type": "number", "minimum": 0, "maximum": 8192 },
    "acceleration": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
    "deceleration": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 },
    "maxSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 8192 }
  },
  "additionalProperties": false
}
