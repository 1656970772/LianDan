{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liandan.local/schemas/config/m1-fire-flow-performance.schema.json",
  "title": "M1 火流技术探针与性能场景",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "world",
    "protocol",
    "performanceSource",
    "performanceFullObstacleFixture",
    "technicalProbes",
    "performanceScenarios"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "const": "m1-fire-flow"
    },
    "world": {
      "$ref": "#/$defs/world"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "performanceSource": {
      "$ref": "#/$defs/source"
    },
    "performanceFullObstacleFixture": {
      "$ref": "#/$defs/fullObstacleFixture"
    },
    "technicalProbes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/technicalProbe"
      }
    },
    "performanceScenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/performanceScenario"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": [
        "warmupSeconds",
        "sampleSeconds",
        "expectedTickHz",
        "expectedDroppedTickCount",
        "totalTickTolerance",
        "fullSecondTickMinimum",
        "fullSecondTickMaximum"
      ],
      "properties": {
        "warmupSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "sampleSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "expectedTickHz": { "type": "integer", "minimum": 1, "maximum": 240 },
        "expectedDroppedTickCount": { "type": "integer", "minimum": 0 },
        "totalTickTolerance": { "type": "integer", "minimum": 0 },
        "fullSecondTickMinimum": { "type": "integer", "minimum": 0 },
        "fullSecondTickMaximum": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["position", "direction", "width"],
      "properties": {
        "position": { "$ref": "#/$defs/vector" },
        "direction": { "$ref": "#/$defs/vector" },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 16384 }
      },
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "fullObstacleRect": {
      "type": "object",
      "required": ["x", "y", "width", "height", "obstacleValue"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "obstacleValue": { "type": "number", "const": 1 }
      },
      "additionalProperties": false
    },
    "fullObstacleFixture": {
      "type": "object",
      "required": ["id", "fullObstacleRects"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "fullObstacleRects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fullObstacleRect" }
        }
      },
      "additionalProperties": false
    },
    "circleFields": {
      "type": "object",
      "required": ["seed", "circleSpawnArea", "radius", "velocity"],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "circleSpawnArea": { "$ref": "#/$defs/rect" },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
        "velocity": { "$ref": "#/$defs/vector" }
      }
    },
    "technicalProbe": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/circleFields" },
        {
          "type": "object",
          "required": ["id", "source", "fullObstacleRects", "circleCount"],
          "properties": {
            "id": {
              "type": "string",
              "enum": ["pillar", "gap", "crowd"]
            },
            "source": { "$ref": "#/$defs/source" },
            "fullObstacleRects": {
              "type": "array",
              "items": { "$ref": "#/$defs/fullObstacleRect" }
            },
            "circleCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": [
        "fireFlowUpdateP95Ms",
        "fireFlowUpdateMaxMs",
        "minimumFpsPerFullSecond"
      ],
      "properties": {
        "fireFlowUpdateP95Ms": { "type": "number", "exclusiveMinimum": 0 },
        "fireFlowUpdateMaxMs": { "type": "number", "exclusiveMinimum": 0 },
        "minimumFpsPerFullSecond": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "performanceScenario": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/circleFields" },
        {
          "type": "object",
          "required": [
            "id",
            "activePearlCount",
            "fullObstacleFixtureId",
            "thresholds"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "activePearlCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "fullObstacleFixtureId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "thresholds": { "$ref": "#/$defs/thresholds" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
