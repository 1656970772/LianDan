{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liandan.local/schemas/config/m2-presentation.schema.json",
  "title": "M5 表现配置",
  "type": "object",
  "required": [
    "schemaVersion",
    "temperature",
    "fire",
    "material",
    "pearls",
    "failure",
    "effects",
    "camera",
    "audio",
    "accessibility",
    "performance"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "temperature": {
      "type": "object",
      "required": ["warmRatio", "blazingRatio"],
      "properties": {
        "warmRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "blazingRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "fire": {
      "type": "object",
      "required": ["afterglowSeconds", "emergenceSeconds", "steadyThresholdSeconds", "geometry", "core", "body", "outer", "ember", "emberRate"],
      "properties": {
        "afterglowSeconds": { "type": "number", "minimum": 0, "maximum": 10 },
        "emergenceSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
        "steadyThresholdSeconds": { "type": "number", "minimum": 0, "maximum": 5 },
        "geometry": {
          "type": "object",
          "required": ["sourceWidthScale", "bodyRadiusPixels", "trailRadiusScale", "tipRadiusScale", "swayPixels", "curlPixels", "particleCount", "bodyDensity", "trailDensity"],
          "properties": {
            "sourceWidthScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
            "bodyRadiusPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 128 },
            "trailRadiusScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
            "tipRadiusScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
            "swayPixels": { "type": "number", "minimum": 0, "maximum": 64 },
            "curlPixels": { "type": "number", "minimum": 0, "maximum": 64 },
            "particleCount": { "type": "integer", "minimum": 32, "maximum": 2000 },
            "bodyDensity": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
            "trailDensity": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
          },
          "additionalProperties": false
        },
        "core": { "$ref": "#/$defs/fireLayer" },
        "body": { "$ref": "#/$defs/fireLayer" },
        "outer": { "$ref": "#/$defs/fireLayer" },
        "ember": { "$ref": "#/$defs/fireLayer" },
        "emberRate": { "type": "number", "minimum": 0, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": ["maskScale", "edgeFeatherPixels", "heatEdgeWidthPixels", "charAlpha", "debrisRate", "debrisLifetimeSeconds"],
      "properties": {
        "maskScale": { "type": "integer", "minimum": 2, "maximum": 8 },
        "edgeFeatherPixels": { "type": "number", "minimum": 0, "maximum": 32 },
        "heatEdgeWidthPixels": { "type": "number", "minimum": 0, "maximum": 64 },
        "charAlpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "debrisRate": { "type": "number", "minimum": 0, "maximum": 1000 },
        "debrisLifetimeSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
      },
      "additionalProperties": false
    },
    "pearls": {
      "type": "object",
      "required": ["medicinalLiquid", "slag", "impurity"],
      "properties": {
        "medicinalLiquid": { "$ref": "#/$defs/pearlProfile" },
        "slag": { "$ref": "#/$defs/pearlProfile" },
        "impurity": { "$ref": "#/$defs/pearlProfile" }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "shatteringStartRatio",
        "gatheringStartRatio",
        "flyingStartRatio",
        "shardsPerSource",
        "maximumParticleCount",
        "scatterRadiusPixels",
        "particleRadiusPixels",
        "resultRadiusPixels",
        "furnaceBottomAnchor",
        "resultAnchor"
      ],
      "properties": {
        "shatteringStartRatio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "gatheringStartRatio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "flyingStartRatio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "shardsPerSource": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maximumParticleCount": { "type": "integer", "minimum": 1, "maximum": 512 },
        "scatterRadiusPixels": { "type": "number", "minimum": 0, "maximum": 256 },
        "particleRadiusPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 32 },
        "resultRadiusPixels": { "type": "number", "exclusiveMinimum": 0, "maximum": 128 },
        "furnaceBottomAnchor": { "$ref": "#/$defs/normalizedAnchor" },
        "resultAnchor": { "$ref": "#/$defs/normalizedAnchor" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": ["shieldDurationSeconds", "damageDurationSeconds", "steamDurationSeconds", "warningOneDurationSeconds", "warningTwoDurationSeconds", "failureDurationSeconds"],
      "properties": {
        "shieldDurationSeconds": { "type": "number", "minimum": 0, "maximum": 5 },
        "damageDurationSeconds": { "type": "number", "minimum": 0, "maximum": 5 },
        "steamDurationSeconds": { "type": "number", "minimum": 0, "maximum": 5 },
        "warningOneDurationSeconds": { "type": "number", "minimum": 0, "maximum": 10 },
        "warningTwoDurationSeconds": { "type": "number", "minimum": 0, "maximum": 10 },
        "failureDurationSeconds": { "type": "number", "minimum": 1, "maximum": 1.5 }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": ["normalCatchStrength", "damageStrength", "fightStrength", "warningTwoStrength", "failureStrength", "durationSeconds", "maxOffsetPixels"],
      "properties": {
        "normalCatchStrength": { "$ref": "#/$defs/strength" },
        "damageStrength": { "$ref": "#/$defs/strength" },
        "fightStrength": { "$ref": "#/$defs/strength" },
        "warningTwoStrength": { "$ref": "#/$defs/strength" },
        "failureStrength": { "$ref": "#/$defs/strength" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
        "maxOffsetPixels": { "type": "number", "minimum": 0, "maximum": 64 }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "required": ["initiallyMuted", "defaultVolume", "mergeWindowMs", "mergeGain", "maxVoices", "profiles"],
      "properties": {
        "initiallyMuted": { "type": "boolean" },
        "defaultVolume": { "type": "number", "minimum": 0, "maximum": 1 },
        "mergeWindowMs": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "mergeGain": { "type": "number", "minimum": 0, "maximum": 4 },
        "maxVoices": { "type": "integer", "minimum": 1, "maximum": 64 },
        "profiles": {
          "type": "object",
          "required": ["fireStart", "fireLoop", "fireStop", "pearlCaught", "pearlShield", "pearlDamaged", "interaction", "warningOne", "warningTwo", "failure"],
          "properties": {
            "fireStart": { "$ref": "#/$defs/audioProfile" },
            "fireLoop": { "$ref": "#/$defs/audioProfile" },
            "fireStop": { "$ref": "#/$defs/audioProfile" },
            "pearlCaught": { "$ref": "#/$defs/audioProfile" },
            "pearlShield": { "$ref": "#/$defs/audioProfile" },
            "pearlDamaged": { "$ref": "#/$defs/audioProfile" },
            "interaction": { "$ref": "#/$defs/audioProfile" },
            "warningOne": { "$ref": "#/$defs/audioProfile" },
            "warningTwo": { "$ref": "#/$defs/audioProfile" },
            "failure": { "$ref": "#/$defs/audioProfile" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": ["reducedMotionFailureDurationSeconds", "reducedMotionCameraMultiplier"],
      "properties": {
        "reducedMotionFailureDurationSeconds": { "type": "number", "minimum": 1, "maximum": 1.5 },
        "reducedMotionCameraMultiplier": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "required": ["particlePoolSize", "steamPoolSize", "pearlPoolSize", "effectPoolInitialCapacity", "effectPoolMaximumCapacity"],
      "properties": {
        "particlePoolSize": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "steamPoolSize": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "pearlPoolSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "effectPoolInitialCapacity": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "effectPoolMaximumCapacity": { "type": "integer", "minimum": 1, "maximum": 5000 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "fireLayer": {
      "type": "object",
      "required": ["color", "alpha"],
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "pearlProfile": {
      "type": "object",
      "required": ["shape", "motion", "surface"],
      "properties": {
        "shape": { "type": "string", "enum": ["droplet", "clump", "spike"] },
        "motion": { "type": "string", "enum": ["swim", "tumble", "jitter"] },
        "surface": { "type": "string", "enum": ["glossy", "rough", "smoky"] }
      },
      "additionalProperties": false
    },
    "strength": { "type": "number", "minimum": 0, "maximum": 1 },
    "normalizedAnchor": {
      "type": "object",
      "required": ["xRatio", "yRatio"],
      "properties": {
        "xRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "yRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "audioProfile": {
      "type": "object",
      "required": ["kind", "attackSeconds", "decaySeconds", "sustainLevel", "releaseSeconds", "frequencyHz", "gain"],
      "properties": {
        "kind": { "type": "string", "enum": ["tone", "noise"] },
        "attackSeconds": { "type": "number", "minimum": 0, "maximum": 5 },
        "decaySeconds": { "type": "number", "minimum": 0, "maximum": 5 },
        "sustainLevel": { "type": "number", "minimum": 0, "maximum": 1 },
        "releaseSeconds": { "type": "number", "minimum": 0, "maximum": 10 },
        "frequencyHz": { "type": "number", "minimum": 20, "maximum": 20000 },
        "gain": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
