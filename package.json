  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate:config": "tsx scripts/validate-config.ts",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "generate:m4-assets": "tsx scripts/generate-m4-material-assets.ts",
    "test:e2e": "playwright test",
    "perf": "npm run validate:config && npm run build && tsx scripts/run-perf-scenario.ts",
