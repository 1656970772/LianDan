    "preview": "vite preview",
    "check": "npm run typecheck && npm run test && npm run validate:config && npm run validate:assets && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "pngjs": "7.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "phaser": "4.1.0"
  }
}
